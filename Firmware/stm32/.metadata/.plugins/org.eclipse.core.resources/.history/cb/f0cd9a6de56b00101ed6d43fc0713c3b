#include "App.h"
#include "core_cm7.h"

#define APP_TAG		"[ APP ] "

#define GEAR_FLAG_BIT				(1U << 0)
#define SPEED_TACHO_FLAG_BIT		(1U << 1)
#define COOLANT_FLAG_BIT			(1U << 2)
#define FUEL_FLAG_BIT				(1U << 3)
#define VOLTAGE_FLAG_BIT			(1U << 4)
#define INDICATIONS_FLAG_BIT		(1U << 5)
#define OP_RUNNING_FLAG_BIT			(1U << 7)

#define RESET(var, bit)			    ((var) &= ~(bit))
#define RESET_FLAG(x)				RESET(flags, x)
#define SET_FLAGS(x)				(flags |= (x))
#define CHECK_FLAG(x)				(flags & (x))

// #define GEAR_PIN_CHECK(gear_to_check)		(sensor_data.gear.##gear_to_check = HAL_GPIO_ReadPin(gear_to_check_GPIO_Port, gear_to_check_Pin))
#define PIN_CHECK(port, bit, pin_base)  (sensor_data.port.bit = !HAL_GPIO_ReadPin(pin_base##_GPIO_Port, pin_base##_Pin))

static const char *gear_names[] = {
    "Neutral",  // bit 0
    "Gear 1",   // bit 1
    "Gear 2",   // bit 2
    "Gear 3",   // bit 3
    "Gear 4",   // bit 4
    "Gear 5"    // bit 5
};

FDCAN_HandleTypeDef* pukk_display_can_interface = NULL;
FDCAN_HandleTypeDef* ecu_can_interface = NULL;
I2C_HandleTypeDef*   ads_interface = NULL;
TIM_HandleTypeDef*	 base_timer = NULL;						// base 1ms timer

volatile uint32_t gearCheckTimestamp = 0;
volatile uint32_t speedTachoCheckTimestamp = 0;
volatile uint32_t coolantCheckTimestamp = 0;
volatile uint32_t fuelCheckTimestamp = 0;
volatile uint32_t voltageCheckTimestamp = 0;
volatile uint32_t indicationsCheckTimestamp = 0;

volatile uint8_t flags = GEAR_FLAG_BIT | SPEED_TACHO_FLAG_BIT | COOLANT_FLAG_BIT | FUEL_FLAG_BIT | VOLTAGE_FLAG_BIT | INDICATIONS_FLAG_BIT;


struct
{
	indicators_t indicators;
	gears_t	gear;
	uint16_t tacho;
	uint8_t speed;
	uint8_t coolant_temp;
	uint16_t fuel_lvl;
	uint8_t battery_volt;
} sensor_data;


void _timer_callback(TIM_HandleTypeDef* htim)
{
	if(htim == base_timer)
	{
		// LOG_ITM_1(APP_TAG "Timer callback\n");
		uint32_t now = HAL_GetTick();
		
		if((now - gearCheckTimestamp) > GEAR_CHECK_TIME)
		{
			if(!CHECK_FLAG(GEAR_FLAG_BIT))
			{
				LOG_ITM_1(APP_TAG "check gears\n");
				gearCheckTimestamp = now;
				
				SET_FLAGS(GEAR_FLAG_BIT);
			}
		}
		if((now - speedTachoCheckTimestamp) > SPEED_TACH_TIME)
		{
			if(!CHECK_FLAG(SPEED_TACHO_FLAG_BIT))
			{
				LOG_ITM_1(APP_TAG "check speed/tacho\n");
				speedTachoCheckTimestamp = now;

				SET_FLAGS(SPEED_TACHO_FLAG_BIT);
			}
		}
		if((now - coolantCheckTimestamp) > COOLANT_TIME)
		{
			if(!CHECK_FLAG(COOLANT_FLAG_BIT | OP_RUNNING_FLAG_BIT))
			{
				LOG_ITM_1(APP_TAG "check coolant\n");
				coolantCheckTimestamp = now;

				SET_FLAGS(COOLANT_FLAG_BIT);
			}
		}
		if((now - fuelCheckTimestamp) > FUEL_GAUGE_TIME)
		{
			if(!CHECK_FLAG(FUEL_FLAG_BIT | OP_RUNNING_FLAG_BIT))
			{
				LOG_ITM_1(APP_TAG "check fuel\n");
				fuelCheckTimestamp = now;

				SET_FLAGS(FUEL_FLAG_BIT);
			}
		}
		if((now - voltageCheckTimestamp) > VOLT_CALIB_TIME)
		{
			if(!CHECK_FLAG(VOLTAGE_FLAG_BIT | OP_RUNNING_FLAG_BIT))
			{
				LOG_ITM_1(APP_TAG "check voltage\n");
				voltageCheckTimestamp = now;

				SET_FLAGS(VOLTAGE_FLAG_BIT);
			}
		}
		if((now - indicationsCheckTimestamp) > INDICATIONS_TIME)
		{
			if(!CHECK_FLAG(INDICATIONS_FLAG_BIT))
			{
				LOG_ITM_1(APP_TAG "check indicators\n");
				indicationsCheckTimestamp = now;

				SET_FLAGS(INDICATIONS_FLAG_BIT);
			}
		}
	}
}

void check_gears()
{
	// sensor_data.gear.neutral = !HAL_GPIO_ReadPin(NEUTRAL_SIG_GPIO_Port, NEUTRAL_SIG_Pin);
	PIN_CHECK(gear, neutral, NEUTRAL_SIG);
	PIN_CHECK(gear, gear_1, GEAR_1_SIG);
	PIN_CHECK(gear, gear_2, GEAR_2_SIG);
	PIN_CHECK(gear, gear_3, GEAR_3_SIG);
	PIN_CHECK(gear, gear_4, GEAR_4_SIG);
	PIN_CHECK(gear, gear_5, GEAR_5_SIG);

	uint8_t gear_val = *((uint8_t *)&sensor_data.gear);
    for (int i = 0; i < 6; i++)
    {
        if (gear_val & (1 << i))
        {
            LOG_ITM_1(APP_TAG "Current gear: %s", gear_names[i]);
            break;  // stop after first match (assumes only one gear is active)
        }
    }
	RESET_FLAG(GEAR_FLAG_BIT);
}

void check_tachospeed()
{

	RESET_FLAG(SPEED_TACHO_FLAG_BIT);
}

void check_ads()
{
	if(!CHECK_FLAG(FUEL_FLAG_BIT | OP_RUNNING_FLAG_BIT))
	{
		// start ads conversion, setup readout on RDY interrupt
		SET_FLAGS(OP_RUNNING_FLAG_BIT);
	}
	if(!CHECK_FLAG(FUEL_FLAG_BIT | OP_RUNNING_FLAG_BIT))
	{
		// start ads conversion, setup readout on RDY interrupt
		SET_FLAGS(OP_RUNNING_FLAG_BIT);
	}
	if(!CHECK_FLAG(FUEL_FLAG_BIT | OP_RUNNING_FLAG_BIT))
	{
		// start ads conversion, setup readout on RDY interrupt
		SET_FLAGS(OP_RUNNING_FLAG_BIT);
	}
}

void check_indicators()
{

	RESET_FLAG(INDICATIONS_FLAG_BIT);
}

void app_init(FDCAN_HandleTypeDef* pukk_can, FDCAN_HandleTypeDef* ecu_can, I2C_HandleTypeDef* ads_i2c, TIM_HandleTypeDef* timer)
{
	pukk_display_can_interface = pukk_can;
	ecu_can_interface = ecu_can;
	ads_interface = ads_i2c;
	base_timer = timer;
	
	// Initialize timer based approach for logging GPIO signals and populate them in a buffer
	
	// Initialize timers for capturing tachmeter/speedometer pulses
	// use a seperate timer for logging pulse counts
	
	// Initialize i2c for communication with ads1115 adc ic
	// ch1: coolant, ch2: fuel gauge, ch3: voltage feedback/callibration (3.36v ideal reading), ch4: connected to GND
	
	// Initialize can bus communication


	// setup all peripherals first, than initiate readout timer callback
	HAL_TIM_RegisterCallback(base_timer, HAL_TIM_PERIOD_ELAPSED_CB_ID, _timer_callback);
	HAL_TIM_Base_Start_IT(base_timer);
}

void app_execute(void)
{
	if (console_line_ready)
	{
		console_line_ready = false;

		console_print_buffer();
	}

	CHECK_FLAG(GEAR_FLAG_BIT) ? (void)check_gears() : (void)0;
	CHECK_FLAG(SPEED_TACHO_FLAG_BIT) ? (void)check_tachospeed() : (void)0;
	CHECK_FLAG(COOLANT_FLAG_BIT | FUEL_FLAG_BIT | VOLTAGE_FLAG_BIT) ? (void)check_ads() : (void)0;
	CHECK_FLAG(INDICATIONS_FLAG_BIT) ? (void)check_indicators() : (void)0;
}
