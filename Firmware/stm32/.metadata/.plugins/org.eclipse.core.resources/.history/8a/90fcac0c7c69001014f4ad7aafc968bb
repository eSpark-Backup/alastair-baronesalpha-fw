void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
    if (huart == console_interface)
    {
        if (!console_line_ready)
        {
            char ch = console_rx_char;

            if (ch == '\r' || ch == '\n')
            {
                console_line_buffer[console_line_index] = '\0';
                console_line_ready = true;

                // Optional: echo newline
                char newline[] = "\r\n";
                HAL_UART_Transmit(console_interface, (uint8_t*)newline, 2, 10);
            }
            else if (console_line_index < CONSOLE_RX_BUFFER_SIZE - 1)
            {
                console_line_buffer[console_line_index++] = ch;
                HAL_UART_Transmit(console_interface, (uint8_t*)&ch, 1, 10); // Echo char
            }
        }

        // Restart reception
        HAL_UART_Receive_IT(console_interface, &console_rx_char, 1);
    }
}
